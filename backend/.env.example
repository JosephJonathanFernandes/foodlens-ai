# FoodLens AI Backend - Environment Variables
# Copy this file to .env and fill in your own values. Never commit .env to version control.

# Application
APP_NAME=FoodLens AI
APP_ENV=development
DEBUG=true
API_BASE_URL=http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000

# CORS - set to your Expo app origin (e.g. http://localhost:19006 or your device IP)
CORS_ORIGINS=http://localhost:19006,http://10.0.2.2:8000,*

# Database
DATABASE_URL=sqlite:///./foodlens.db

# OCR Engine (paddleocr or tesseract)
OCR_ENGINE=paddleocr

# LLM / AI explanation (configurable)
# Set LLM_PROVIDER to one of: openai, anthropic, gemini, mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Translation provider (configurable)
# Set TRANSLATION_PROVIDER to one of: google, azure, libre, mock
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=

# Security
SECRET_KEY=replace-with-a-strong-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
